# Azure AI Foundry (primary)
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your-azure-api-key
AZURE_API_VERSION=2024-08-01-preview

# Deployment names per role
AGENT_DEPLOYMENT=gpt-4o
VISION_DEPLOYMENT=gpt-4o
OPTIMIZER_DEPLOYMENT=gpt-4o

# OpenAI-compatible endpoint (alternative to Azure)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key

# Demo cache: set to 1 to cache LLM responses on disk
DEMO_CACHE=0
