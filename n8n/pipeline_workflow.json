      "id": "docdesk-download-drive-file",
      "name": "Download Drive File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        1080
      ],
      "disabled": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nconst allowed = new Set([\"pdf\", \"png\", \"jpg\", \"jpeg\", \"webp\"]);\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const meta = item.binary?.data;\n  if (!meta) continue;\n  const filename = meta.fileName || item.json.name || \"drive-document.pdf\";\n  const ext = filename.split(\".\").pop().toLowerCase();\n  if (!allowed.has(ext)) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(i, \"data\");\n  const clean = String(item.json.id || Date.now()).replace(/[^a-zA-Z0-9_-]/g, \"\");\n  out.push({json: {body: {doc_id: `drive-${clean}`, company_id: \"company_b\", filename, file_b64: buffer.toString(\"base64\"), source: \"drive\"}}});\n}\nreturn out;"
      },
