    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst missing = [\"doc_id\", \"company_id\"].filter(k => !body[k]);\nif (missing.length) throw new Error(\"Missing required field(s): \" + missing.join(\", \"));\nconst filename = body.filename || \"\";\nconst text = body.text || \"\";\nconst ext = filename.split(\".\").pop().toLowerCase();\nconst head = text.slice(0, 80).toLowerCase();\nlet docType = \"invoice\";\nif (head.includes(\"bon de commande\") || head.includes(\"purchase order\")) docType = \"purchase_order\";\nelse if (head.includes(\"recu\") || head.includes(\"reçu\") || head.includes(\"receipt\")) docType = \"receipt\";\nreturn [{ json: { doc_id: body.doc_id, company_id: body.company_id, source: body.source || 'webhook', filename, file_b64: body.file_b64 || \"\", text, doc_type: docType, modality: [\"jpg\", \"jpeg\", \"png\", \"webp\"].includes(ext) ? \"photo\" : \"text\" } }];"
      },
      "id": "5f0c1a52-6a7e-4b8f-9d31-0c2e7a4b1001",
